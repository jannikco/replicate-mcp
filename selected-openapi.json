{
  "openapi": "3.1.0",
  "info": {
    "title": "Replicate selected operations",
    "version": "0.1.0",
    "description": "Reviewed local connector bindings for manual API import. No provider credentials are included; authentication and hosted execution require separate configuration and tests."
  },
  "servers": [
    {
      "url": "https://api.replicate.com/v1"
    }
  ],
  "paths": {
    "/models/{model_owner}/{model_name}": {
      "get": {
        "operationId": "get_model",
        "summary": "Inspect model metadata and latest_version.openapi_schema before constructing input.",
        "parameters": [
          {
            "name": "model_owner",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            }
          },
          {
            "name": "model_name",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            }
          }
        ],
        "x-pipmcp-read-only": true,
        "responses": {
          "200": {
            "description": "Provider response; inspect provider documentation for result fields."
          }
        }
      }
    },
    "/predictions": {
      "post": {
        "operationId": "create_prediction",
        "summary": "Start a billable asynchronous prediction after explicit approval. Read status/output with get_prediction; model-specific input must match its schema.",
        "parameters": [],
        "x-pipmcp-read-only": false,
        "responses": {
          "200": {
            "description": "Provider response; inspect provider documentation for result fields."
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "version": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 300
                  },
                  "input": {
                    "type": "object",
                    "maxProperties": 64,
                    "additionalProperties": true
                  }
                },
                "required": [
                  "version",
                  "input"
                ]
              }
            }
          }
        }
      }
    },
    "/predictions/{prediction_id}": {
      "get": {
        "operationId": "get_prediction",
        "summary": "Read prediction status, error and output metadata; starting/processing are not terminal success.",
        "parameters": [
          {
            "name": "prediction_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          }
        ],
        "x-pipmcp-read-only": true,
        "responses": {
          "200": {
            "description": "Provider response; inspect provider documentation for result fields."
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "providerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  },
  "security": [
    {
      "providerAuth": []
    }
  ]
}
